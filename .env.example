# Aangan Studio - environment variables.
# Copy to .env and fill in. Never commit .env, never paste keys into chat.
# Put each value straight after the = sign: no spaces, no quotes, no comments on the same line.

# ---------- AI (extraction + summaries) ----------
# claude or gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Model for Gemini (gemini-2.5-flash is closed to new keys)
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=

# ---------- Database: Neon (Postgres) ----------
# Neon dashboard -> your project -> Connect. Use the "pooled" string for the app
# and the "direct" (unpooled) string for creating tables.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------- Voice: Vaani Labs ----------
VAANI_API_KEY=
VAANI_AGENT_ID=
VAANI_WEBHOOK_SECRET=

# ---------- Booking: Cal.com ----------
# cal.com -> Settings -> Developer -> API keys
CAL_API_KEY=
# Numeric ID of the "Site visit" event type (60 min) and the "Phone call" event type (30 min).
# Find it in the address bar when you open the event type: cal.com/event-types/<ID>
CAL_EVENT_TYPE_ID_SITE_VISIT=
CAL_EVENT_TYPE_ID_CALL=
# Your Cal.com username (the part after cal.com/)
CAL_USERNAME=
# Secret you type when you create the webhook in Cal.com (for reschedule/cancel/no-show updates)
CAL_WEBHOOK_SECRET=

# ---------- Email: Resend ----------
# resend.com -> API Keys
RESEND_API_KEY=
# For testing use onboarding@resend.dev (Resend only delivers it to the email you signed up with).
# For real use, verify your own domain in Resend and use e.g. leads@yourdomain.com
EMAIL_FROM=onboarding@resend.dev
# Where the designer brief, daily digest and escalation alerts go (your MESA email)
DESIGNER_EMAIL=

# ---------- CRM: HubSpot ----------
HUBSPOT_TOKEN=

# ---------- Code + hosting ----------
# GitHub: the gh tool on this computer is already signed in as souvikpati-bit, so no token is needed.
GITHUB_REPO=souvikpati-bit/aangan-studio
# Vercel: only needed if you want me to deploy from here. Create at vercel.com/account/tokens
VERCEL_TOKEN=
# Public address of the deployed app (used in email links and webhooks), e.g. https://aangan-studio.vercel.app
APP_URL=http://localhost:3000

# ---------- Login (set when the login screen is built) ----------
AUTH_SECRET=

# ---------- SMS ----------
# mock = log "SMS would be sent" in the dashboard (no DLT needed for the test version)
SMS_MODE=mock
